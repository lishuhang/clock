# keepitrun v1.27 环境变量模板
# 复制为 .env 后自行填写。不要提交 .env，也不要在 README、日志或 todo 中记录实际凭据。

# GitHub 内容同步所需凭据。
GITHUB_TOKEN=your_github_token_here

# RSS 翻译引擎。02_combine-gemini.py 的自动顺序为：Gemini -> GLM HTTP API -> Google Free Translate。
# 未设置 Gemini 或 GLM 时，脚本会跳过对应引擎；Google Free Translate 无需此处配置。
GEMINI_API_KEY=
GLM_API_KEY=

# 可选：覆盖默认模型名。v1.26 默认已升级至官方免费档最新版：
#   Gemini = gemini-3.8-flash（ai.google.dev Free of charge 档）
#   GLM    = glm-4.7-flash（docs.bigmodel.cn 输入/输出均免费档）
# GEMINI_MODEL=gemini-3.8-flash
# GLM_MODEL=glm-4.7-flash

# v1.19 已移除 Unsplash 和马良注册任务；请不要在此模板中加入其密钥、令牌或密码。
