 ],
 "subs": [
  {
   "start": 0.0,
   "end": 1.0270588235294118,
   "text": "韩红这次宣发，"
  },
  {
   "start": 1.0270588235294118,
   "end": 2.347563025210084,
   "text": "可能是中国电影史上"
  },
  {
   "start": 2.347563025210084,
   "end": 3.8147899159663865,
   "text": "帮倒忙最严重的一次。"
  },
  {
   "start": 3.8147899159663865,
   "end": 5.428739495798319,
   "text": "抓特务成本1.65亿，"
  },
  {
   "start": 5.428739495798319,
   "end": 7.776302521008404,
   "text": "档期两个月，票房只有1.19亿。"
  },
  {
   "start": 7.776302521008404,
   "end": 9.536974789915966,
   "text": "但8月28日上线流媒体，"
  },
  {
   "start": 9.536974789915966,
   "end": 11.1509243697479,
   "text": "第二天鹅厂热度近两万，"
  },
  {
   "start": 11.1509243697479,
   "end": 13.351764705882353,
   "text": "爱奇艺和优酷也冲到7000多。"
  },
  {
   "start": 13.351764705882353,
   "end": 15.552605042016808,
   "text": "弹幕都说“欠冯导一张电影票”。"
  },
  {
   "start": 15.552605042016808,
   "end": 17.46,
   "text": "抓特务的口碑怎么就反转了？"
  },
  {
   "start": 17.46,
   "end": 18.234621212121212,
   "text": "娱乐资本论"
  },
  {
   "start": 18.234621212121212,
   "end": 19.628939393939394,
   "text": "拆了1997年以来"
  },
  {
   "start": 19.628939393939394,
   "end": 21.023257575757576,
   "text": "冯小刚13部电影的"
  },
  {
   "start": 21.023257575757576,
   "end": 22.262651515151514,
   "text": "3292条短评，"
  },
  {
   "start": 22.262651515151514,
   "end": 24.276666666666664,
   "text": "发现影片下档以后口碑反转，"
  },
  {
   "start": 24.276666666666664,
   "end": 25.670984848484846,
   "text": "在他身上并不少见。"
  },
  {
   "start": 25.670984848484846,
   "end": 27.684999999999995,
   "text": "《抓特务》上线流媒体之后，"
  },
  {
   "start": 27.684999999999995,
   "end": 29.544090909090905,
   "text": "虽然豆瓣评分依然7.4，"
  },
  {
   "start": 29.544090909090905,
   "end": 30.938409090909087,
   "text": "但抗议性的一星差评"
  },
  {
   "start": 30.938409090909087,
   "end": 31.713030303030298,
   "text": "基本消失，"
  },
  {
   "start": 31.713030303030298,
   "end": 33.41719696969697,
   "text": "从12%降至3.4%，"
  },
  {
   "start": 33.41719696969697,
   "end": 35.276287878787876,
   "text": "而4星打分上升近10%，"
  },
  {
   "start": 35.276287878787876,
   "end": 37.135378787878786,
   "text": "更多观众认为它值得一看。"
  },
  {
   "start": 37.135378787878786,
   "end": 37.91,
   "text": "相比之下，"
  },
  {
   "start": 37.91,
   "end": 39.39338983050847,
   "text": "院线期占比最高的"
  },
  {
   "start": 39.39338983050847,
   "end": 41.80389830508474,
   "text": "是46.5%的混合型评价，"
  },
  {
   "start": 41.80389830508474,
   "end": 43.10186440677966,
   "text": "夸导演和剧本，"
  },
  {
   "start": 43.10186440677966,
   "end": 45.141525423728815,
   "text": "但又不满意演员、节奏。"
  },
  {
   "start": 45.141525423728815,
   "end": 47.18118644067797,
   "text": "小娱进一步将评论拆分为"
  },
  {
   "start": 47.18118644067797,
   "end": 49.03542372881356,
   "text": "六种语义框架后发现，"
  },
  {
   "start": 49.03542372881356,
   "end": 50.518813559322034,
   "text": "流媒体上线以后，"
  },
  {
   "start": 50.518813559322034,
   "end": 52.74389830508475,
   "text": "围绕导演能力、演员表演等"
  },
  {
   "start": 52.74389830508475,
   "end": 54.96898305084746,
   "text": "展开的“专业能力”评价，"
  },
  {
   "start": 54.96898305084746,
   "end": 57.37949152542373,
   "text": "由46.1%上升至56%，"
  },
  {
   "start": 57.37949152542373,
   "end": 59.790000000000006,
   "text": "涉及人物道德、公众形象等，"
  },
  {
   "start": 59.79,
   "end": 61.811884057971014,
   "text": "则从9.1%下降至3.7%。"
  },
  {
   "start": 61.811884057971014,
   "end": 63.25608695652174,
   "text": "越来越多的评论写道，"
  },
  {
   "start": 63.25608695652174,
   "end": 64.84471014492753,
   "text": "很多人是压根没看懂影片"
  },
  {
   "start": 64.84471014492753,
   "end": 66.43333333333332,
   "text": "真正要表达的，才黑它，"
  },
  {
   "start": 66.43333333333332,
   "end": 68.31079710144927,
   "text": "这剧其实让韩大炮给耽误了。"
  },
  {
   "start": 68.31079710144927,
   "end": 70.33268115942028,
   "text": "再加上院线期间类型预期错位，"
  },
  {
   "start": 70.33268115942028,
   "end": 72.06572463768114,
   "text": "片名《抓特务》像谍战片，"
  },
  {
   "start": 72.06572463768114,
   "end": 73.94318840579709,
   "text": "实际是北京胡同的生活变迁，"
  },
  {
   "start": 73.94318840579709,
   "end": 76.39833333333333,
   "text": "流媒体没那么多人“必须值回票价”。"
  },
  {
   "start": 76.39833333333333,
   "end": 78.42021739130433,
   "text": "此外，真活在那个年代的观众，"
  },
  {
   "start": 78.42021739130433,
   "end": 79.71999999999998,
   "text": "如今也老了，在家看"
  },
  {
   "start": 79.72,
   "end": 81.47258426966292,
   "text": "还是比去趟电影院方便。"
  },
  {
   "start": 81.47258426966292,
   "end": 82.42853932584269,
   "text": "有意思的是，"
  },
  {
   "start": 82.42853932584269,
   "end": 84.49977528089887,
   "text": "这种“非院线期口碑反转”，"
  },
  {
   "start": 84.49977528089887,
   "end": 85.77438202247191,
   "text": "几乎贯穿了冯小刚"
  },
  {
   "start": 85.77438202247191,
   "end": 87.52696629213483,
   "text": "在各个历史时期的作品。"
  },
  {
   "start": 87.52696629213483,
   "end": 89.43887640449438,
   "text": "2012年《一九四二》，"
  },
  {
   "start": 89.43887640449438,
   "end": 90.87280898876405,
   "text": "豆瓣只有6.1分，"
  },
  {
   "start": 90.87280898876405,
   "end": 92.14741573033709,
   "text": "近年涨到8.3。"
  },
  {
   "start": 92.14741573033709,
   "end": 93.9,
   "text": "《私人订制》当年被骂，"
  },
  {
   "start": 93.9,
   "end": 94.825,
   "text": "如今却有人说"
  },
  {
   "start": 94.825,
   "end": 96.82916666666667,
   "text": "“当年的讽刺现在才看懂”。"
  },
  {
   "start": 96.82916666666667,
   "end": 98.37083333333334,
   "text": "在冯导职业生涯初期，"
  },
  {
   "start": 98.37083333333334,
   "end": 100.06666666666666,
   "text": "1997年《甲方乙方》"
  },
  {
   "start": 100.06666666666666,
   "end": 102.53333333333333,
   "text": "600万成本拿下3600万票房，"
  },
  {
   "start": 102.53333333333333,
   "end": 103.6125,
   "text": "贺岁喜剧让观众"
  },
  {
   "start": 103.6125,
   "end": 105.30833333333334,
   "text": "先认准了他的专业能力。"
  },
  {
   "start": 105.30833333333334,
   "end": 107.15833333333333,
   "text": "此后《手机》《天下无贼》"
  },
  {
   "start": 107.15833333333333,
   "end": 108.7,
   "text": "《夜宴》等类型突围，"
  },
  {
   "start": 108.7,
   "end": 109.89777777777778,
   "text": "关于冯导的讨论"
  },
  {
   "start": 109.89777777777778,
   "end": 111.60888888888888,
   "text": "逐渐转向道德、人格、"
  },
  {
   "start": 111.60888888888888,
   "end": 112.80666666666666,
   "text": "社会文化层面。"
  },
  {
   "start": 112.80666666666666,
   "end": 114.51777777777777,
   "text": "2018年冯小刚宣布"
  },
  {
   "start": 114.51777777777777,
   "end": 115.88666666666666,
   "text": "《手机2》开拍，"
  },
  {
   "start": 115.88666666666666,
   "end": 117.42666666666665,
   "text": "15年前因为第一部"
  },
  {
   "start": 117.42666666666665,
   "end": 118.79555555555554,
   "text": "与其闹翻的崔永元"
  },
  {
   "start": 118.79555555555554,
   "end": 119.99333333333331,
   "text": "随即公开回应，"
  },
  {
   "start": 119.99333333333331,
   "end": 121.5333333333333,
   "text": "双方矛盾不断升级，"
  },
  {
   "start": 121.5333333333333,
   "end": 124.09999999999997,
   "text": "进一步牵出“阴阳合同”等风波。"
  },
  {
   "start": 124.1,
   "end": 125.54198473282442,
   "text": "这就是为什么《手机》"
  },
  {
   "start": 125.54198473282442,
   "end": 126.98396946564884,
   "text": "是在2003年上映，"
  },
  {
   "start": 126.98396946564884,
   "end": 129.00274809160305,
   "text": "但是评价却集中在2018年。"
  },
  {
   "start": 129.00274809160305,
   "end": 130.73312977099238,
   "text": "《集结号》《唐山大地震》"
  },
  {
   "start": 130.73312977099238,
   "end": 132.7519083969466,
   "text": "《一九四二》《我不是潘金莲》"
  },
  {
   "start": 132.7519083969466,
   "end": 134.04969465648858,
   "text": "接连带入公共议题，"
  },
  {
   "start": 134.04969465648858,
   "end": 136.0684732824428,
   "text": "《私人订制》被当成还债之作，"
  },
  {
   "start": 136.0684732824428,
   "end": 138.087251908397,
   "text": "评论说“以前挺接地气一导演，"
  },
  {
   "start": 138.087251908397,
   "end": 139.6734351145039,
   "text": "现在俩脚不沾地儿了”。"
  },
  {
   "start": 139.6734351145039,
   "end": 141.11541984732833,
   "text": "上映时，大家拿眼前的"
  },
  {
   "start": 141.11541984732833,
   "end": 142.9900000000001,
   "text": "现实舆论和消费预期去衡量。"
  },
  {
   "start": 142.99,
   "end": 145.34351351351353,
   "text": "加上冯小刚长期处在舆论中心，"
  },
  {
   "start": 145.34351351351353,
   "end": 147.69702702702705,
   "text": "性格强势，习惯公开回应争议，"
  },
  {
   "start": 147.69702702702705,
   "end": 149.71432432432434,
   "text": "也让部分观众感觉不舒服。"
  },
  {
   "start": 149.71432432432434,
   "end": 150.8910810810811,
   "text": "几年十几年后，"
  },
  {
   "start": 150.8910810810811,
   "end": 152.5721621621622,
   "text": "当年的现实变成历史，"
  },
  {
   "start": 152.5721621621622,
   "end": 154.7575675675676,
   "text": "同一部电影又获得新的解读。"
  },
  {
   "start": 154.7575675675676,
   "end": 156.7748648648649,
   "text": "评论说，“有的电影存在的"
  },
  {
   "start": 156.7748648648649,
   "end": 158.28783783783786,
   "text": "意义就是记录时代，"
  },
  {
   "start": 158.28783783783786,
   "end": 159.80081081081082,
   "text": "看一部少一部了。”"
  },
  {
   "start": 159.80081081081082,
   "end": 161.65,
   "text": "过去三十年，冯小刚几乎"
  },
  {
   "start": 161.65,
   "end": 162.31868686868688,
   "text": "完整经历了国产商业片"
  },
  {
   "start": 162.31868686868688,
   "end": 162.78676767676768,
   "text": "从贺岁档崛起、"
  },
  {
   "start": 162.78676767676768,
   "end": 163.52232323232323,
   "text": "大片时代、主旋律扩张、"
  },
  {
   "start": 163.52232323232323,
   "end": 164.32474747474748,
   "text": "现实题材扩张等多个环节。"
  },
  {
   "start": 164.32474747474748,
   "end": 164.92656565656566,
   "text": "观众看待他的标准，"
  },
  {
   "start": 164.92656565656566,
   "end": 165.59525252525253,
   "text": "也从单一的专业能力，"
  },
  {
   "start": 165.59525252525253,
   "end": 166.06333333333333,
   "text": "逐渐延伸到他的"
  },
  {
   "start": 166.06333333333333,
   "end": 166.79888888888888,
   "text": "立场、人格、资本关系，"
  },
  {
   "start": 166.79888888888888,
   "end": 167.46757575757576,
   "text": "以及他所代表的时代。"
  },
  {
   "start": 167.46757575757576,
   "end": 168.27,
   "text": "冯小刚在公众眼中的身份，"
  },
  {
   "start": 168.27,
   "end": 169.93541666666667,
   "text": "也从最懂观众的贺岁喜剧导演，"
  },
  {
   "start": 169.93541666666667,
   "end": 171.481875,
   "text": "一步步走向了时代的记录者。"
  },
  {
   "start": 171.481875,
   "end": 173.14729166666666,
   "text": "你怎么看《抓特务》这次反转？"
  },
  {
   "start": 173.14729166666666,
   "end": 173.98,
   "text": "评论区聊聊吧！"
  }
 ],
